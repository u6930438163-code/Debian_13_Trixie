[Unit]
Description=Debian 13 System API and command terminal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian13
Group=debian13
WorkingDirectory=/var/lib/debian13/workspace
EnvironmentFile=/etc/debian13/system.env
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=WORKSPACE_DIR=/var/lib/debian13/workspace
ExecStart=/usr/bin/python3 /usr/local/lib/debian13/system/server.py
Restart=on-failure
RestartSec=3s
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/debian13/workspace
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target

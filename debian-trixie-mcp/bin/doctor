#!/usr/bin/env python3
"""Skrypt diagnostyczny Debian 13 Trixie MCP Server (bin/doctor).

Weryfikuje:
- Zgodność systemu Debian 13 (Trixie) i wersję Pythona (PEP 668)
- Obecność i poprawność wirtualnego środowiska .venv oraz wymaganych bibliotek
- Istnienie i uprawnienia pliku .env (wymagane chmod 600, ochrona w .gitignore)
- Poprawność tokenu Bearer (długość, brak domyślnego placeholdera)
- Uprawnienia do katalogów stanu (~/.local/state/debian-trixie-mcp)
- Uprawnienia sudo i konfigurację trybu ROOT_SHELL_MODE
- Narzędzia pomocnicze (docker, podman, tmux, git)
"""
from __future__ import annotations

import getpass
import os
import shutil
import stat
import subprocess
import sys
from pathlib import Path


def color(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m"


def ok(msg: str):
    print(f" {color('[OK]', '1;32')} {msg}")


def warn(msg: str):
    print(f" {color('[OSTRZEŻENIE]', '1;33')} {msg}")


def fail(msg: str):
    print(f" {color('[BŁĄD]', '1;31')} {msg}")


def main() -> int:
    errors = 0
    warnings = 0

    print(color("\n====================================================================", "1;36"))
    print(color("      DEBIAN 13 TRIXIE MCP SERVER - DIAGNOSTYKA SYSTEMOWA (DOCTOR)  ", "1;36"))
    print(color("====================================================================\n", "1;36"))

    base_dir = Path(__file__).resolve().parent.parent

    # 1. System operacyjny
    print(color("1. System operacyjny i środowisko:", "1;34"))
    deb_ver_file = Path("/etc/debian_version")
    if deb_ver_file.exists():
        deb_ver = deb_ver_file.read_text(encoding="utf-8").strip()
        ok(f"Dystrybucja Debian: wersja '{deb_ver}'")
    else:
        warn("Nie znaleziono pliku /etc/debian_version. Czy to na pewno Debian 13?")
        warnings += 1

    py_ver = sys.version_info
    if py_ver.major == 3 and py_ver.minor >= 10:
        ok(f"Wersja Pythona: {py_ver.major}.{py_ver.minor}.{py_ver.micro}")
    else:
        fail(f"Nieobsługiwana wersja Pythona: {py_ver.major}.{py_ver.minor}. Wymagany Python 3.10+")
        errors += 1

    # 2. Wirtualne środowisko (.venv) i PEP 668
    print(color("\n2. Wirtualne środowisko .venv (PEP 668):", "1;34"))
    venv_dir = base_dir / ".venv"
    venv_python = venv_dir / "bin" / "python3"

    if venv_dir.exists() and venv_python.exists():
        ok(f"Katalog .venv znaleziony: {venv_dir}")

        # Sprawdzamy pakiety wewnątrz .venv
        packages = ["mcp", "httpx", "dotenv", "uvicorn", "starlette"]
        for pkg in packages:
            res = subprocess.run(
                [str(venv_python), "-c", f"import {pkg}"],
                capture_output=True,
                text=True,
            )
            if res.returncode == 0:
                ok(f"Pakiet '{pkg}' zainstalowany w .venv")
            else:
                fail(f"Brak pakietu '{pkg}' w .venv (uruchom: ./install.sh)")
                errors += 1
    else:
        fail("Brak wirtualnego środowiska .venv! Uruchom najpierw: ./install.sh")
        errors += 1

    # 3. Konfiguracja i ochrona sekretów (.env)
    print(color("\n3. Konfiguracja (.env) i ochrona sekretów:", "1;34"))
    env_file = base_dir / ".env"
    gitignore_file = base_dir / ".gitignore"

    if gitignore_file.exists():
        gi_content = gitignore_file.read_text(encoding="utf-8")
        if ".env" in gi_content:
            ok("Plik .env jest chroniony w .gitignore")
        else:
            fail("Plik .env NIE jest dodany do .gitignore! Grozi wyciekiem sekretów!")
            errors += 1
    else:
        warn("Brak pliku .gitignore w katalogu serwera.")
        warnings += 1

    if env_file.exists():
        st = env_file.stat()
        mode = stat.S_IMODE(st.st_mode)
        if mode == 0o600:
            ok("Uprawnienia pliku .env są prawidłowe (chmod 600 - tylko odczyt/zapis właściciela)")
        else:
            fail(f"Niebezpieczne uprawnienia .env: {oct(mode)}! Wykonaj: chmod 600 {env_file}")
            errors += 1

        # Wczytujemy zmienne z .env
        env_vars = {}
        for line in env_file.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env_vars[k.strip()] = v.strip()

        token = env_vars.get("MCP_BEARER_TOKEN", "")
        if not token:
            fail("Brak MCP_BEARER_TOKEN w .env! Serwer HTTP nie uruchomi się.")
            errors += 1
        elif "zastap_tym" in token or "losowy" in token:
            fail("MCP_BEARER_TOKEN zawiera domyślny placeholder! Wygeneruj bezpieczny token.")
            errors += 1
        elif len(token) < 32:
            fail(f"MCP_BEARER_TOKEN jest za krótki ({len(token)} znaki). Wymagane min. 32 znaki.")
            errors += 1
        else:
            ok(f"MCP_BEARER_TOKEN skonfigurowany prawidłowo (długość: {len(token)} znaków)")

        mode = env_vars.get("ROOT_SHELL_MODE", "approve")
        ok(f"Tryb ROOT_SHELL_MODE: '{mode}' ({'BEZPIECZNY, kolejka zatwierdzeń' if mode == 'approve' else 'Otwarty, sudo -n'})")

    else:
        fail("Brak pliku .env! Skopiuj .env.example do .env i zabezpiecz go (chmod 600).")
        errors += 1

    # 4. Stan katalogu roboczego i zadań
    print(color("\n4. Pamięć stanu (~/.local/state/debian-trixie-mcp):", "1;34"))
    state_dir = Path.home() / ".local" / "state" / "debian-trixie-mcp"
    pending_dir = state_dir / "pending"
    results_dir = state_dir / "results"

    if state_dir.exists() and os.access(state_dir, os.W_OK):
        ok(f"Katalog stanu istnieje i ma prawa zapisu: {state_dir}")
    else:
        warn(f"Katalog stanu nie istnieje lub brak praw zapisu: {state_dir} (zostanie utworzony)")
        warnings += 1

    # 5. Uprawnienia Root i Sudo
    print(color("\n5. Uprawnienia sudo i powłoka root:", "1;34"))
    current_user = getpass.getuser()
    ok(f"Bieżący użytkownik: {current_user} (serwer działa jako zwykły użytkownik)")

    if shutil.which("sudo"):
        try:
            sudo_check = subprocess.run(["sudo", "-n", "true"], capture_output=True)
            if sudo_check.returncode == 0:
                ok("Użytkownik posiada aktywne/bezhasłowe uprawnienia sudo (sudo -n true).")
            else:
                ok("Sudo wymaga hasła przy uruchomieniu (standardowy, bezpieczny tryb dla bin/root-approve).")
        except Exception:
            warn("Nie udało się przetestować polecenia sudo.")
            warnings += 1
    else:
        warn("Brak narzędzia sudo w systemie (zainstaluj pakiet sudo: apt install sudo).")
        warnings += 1

    sudoers_rule = Path("/etc/sudoers.d/debian-trixie-mcp")
    if sudoers_rule.exists():
        ok("Reguła /etc/sudoers.d/debian-trixie-mcp istnieje.")
        if shutil.which("visudo") and shutil.which("sudo"):
            visudo_check = subprocess.run(["sudo", "visudo", "-cf", str(sudoers_rule)], capture_output=True, text=True)
            if visudo_check.returncode == 0:
                ok("Składnia reguły sudoers jest poprawna (visudo -cf).")
            else:
                fail(f"Błąd składni reguły sudoers: {visudo_check.stderr.strip()}")
                errors += 1
        else:
            warn("Brak narzędzia visudo do sprawdzenia reguły sudoers.")

    # 6. Narzędzia pomocnicze
    print(color("\n6. Narzędzia pomocnicze w systemie:", "1;34"))
    for tool_name in ["git", "tmux", "curl", "jq"]:
        if shutil.which(tool_name):
            ok(f"Zainstalowano: {tool_name}")
        else:
            warn(f"Brak narzędzia: {tool_name} (zalecana instalacja: sudo apt install {tool_name})")
            warnings += 1

    containers = shutil.which("docker") or shutil.which("podman")
    if containers:
        ok(f"Środowisko kontenerowe dostępne: {Path(containers).name}")
    else:
        warn("Brak docker/podman w systemie (wtyczka containers będzie nieaktywna).")

    # Podsumowanie
    print(color("\n====================================================================", "1;36"))
    if errors == 0:
        print(color(f" DIAGNOSTYKA ZAKOŃCZONA POMYŚLNIE! Błędy: 0, Ostrzeżenia: {warnings}", "1;32"))
        print(" Serwer MCP jest gotowy do współpracy z Claude.")
        return 0
    else:
        print(color(f" WYKRYTO KRYTYCZNE BŁĘDY: {errors} (Ostrzeżenia: {warnings})", "1;31"))
        print(" Popraw powyższe błędy przed uruchomieniem serwera.")
        return 1


if __name__ == "__main__":
    sys.exit(main())

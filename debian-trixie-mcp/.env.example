# ==============================================================================
# Konfiguracja Serwera MCP - Debian 13 "Trixie"
# Skopiuj ten plik do .env i zabezpiecz uprawnienia: chmod 600 .env
# ==============================================================================

# --- Transport i Sieć ---
# Transport: stdio (domyślny, dla Claude Code / Desktop) lub http (streamable-http)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765

# Wymagany Bearer Token dla transportu HTTP (minimum 32 znaki, porównywany przez hmac.compare_digest)
# W trybie HTTP serwer odmówi uruchomienia, jeśli token jest pusty!
# Wygeneruj własny: openssl rand -hex 32
MCP_BEARER_TOKEN=zastap_tym_losowy_wygenerowany_bezpieczny_token_o_dlugosci_64_znakow

# Ścieżka katalogu roboczego dla operacji plikowych i git (ochrona przed ucieczką)
# Puste = bieżący katalog uruchomienia
MCP_WORKSPACE=

# Aktywne wtyczki oddzielone przecinkami (lub * dla wszystkich)
# Dostępne: system,command,filesystem,ai_bridge,gemini,github,containers,web_fetch,tmux,systemd_control,notify,root_shell
MCP_PLUGINS=system,command,filesystem,ai_bridge,gemini,github,containers,web_fetch,tmux,systemd_control,notify,root_shell

# --- Bezpieczeństwo Powłoki i Uprawnień Root (Wtyczka root_shell) ---
# Czy zezwolić na shell_exec (jako zwykły użytkownik przez bash -c) [0 lub 1]
SHELL_ENABLED=1

# Czy zezwolić na root_exec (z uprawnieniami roota) [0 lub 1]
ROOT_SHELL_ENABLED=1

# Tryb wykonania root:
# - approve: (DOMYŚLNY I BEZPIECZNY) zapisuje zadanie do kolejki, wymaga zatwierdzenia przez operatora w terminalu: bin/root-approve
# - open: natychmiastowe wykonanie przez sudo -n (wymaga reguły w /etc/sudoers.d/ skonfigurowanej przez install.sh --root-open)
ROOT_SHELL_MODE=approve

# Katalog stanu zadań i audytu (domyślnie ~/.local/state/debian-trixie-mcp)
MCP_STATE_DIR=

# --- Integracje AI (Wtyczki ai_bridge i gemini) ---
# Klucz API Google AI Studio dla modeli Gemini (opcjonalny, wymagany dla wtyczki gemini)
GEMINI_API_KEY=

# Klucz i adres dla API zgodnego z OpenAI / lokalnej Ollamy (opcjonalny)
OPENAI_API_KEY=
OPENAI_API_BASE=http://127.0.0.1:11434/v1

# --- GitHub (Wtyczka github) ---
# Osobisty token dostępu GitHub (opcjonalny)
GITHUB_TOKEN=
# Czy zezwolić na operacje zapisu (tworzenie issues, PR itp.) [0 lub 1]
GITHUB_ALLOW_WRITE=0

# --- Kontenery i Systemd ---
# Czy zezwolić na zatrzymywanie/restartowanie kontenerów docker/podman [0 lub 1]
CONTAINER_ALLOW_CONTROL=0

# Czy zezwolić na wysyłanie klawiszy do sesji tmux [0 lub 1]
TMUX_ALLOW_SEND=0

# Dozwolone usługi systemd do restartowania/zatrzymywania (oddzielone przecinkami)
SYSTEMD_ALLOWED_SERVICES=nginx,postgresql,ollama,docker,redis

# --- Powiadomienia (Wtyczka notify) ---
# Serwer powiadomień ntfy (opcjonalnie własna instancja lub domyślna chmura ntfy.sh)
NTFY_SERVER=https://ntfy.sh
